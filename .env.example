# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE - KLTN 13
# ==============================================================================

PROJECT_NAME=kltn13-personalized-learning-recommendation
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Backend API Configuration
# ------------------------------------------------------------------------------
APP_NAME=Hệ Thống Gợi Ý Chiến Lược Học Tập Cá Nhân Hóa
APP_VERSION=1.0.0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=kltn13_super_secret_jwt_key_huit_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (Docker)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123
POSTGRES_DB=personalized_learning_db
POSTGRES_HOST=localhost

# Cổng ngoài Host máy tính (Đặt 5433 để tránh xung đột với PostgreSQL service cổng 5432 trên Windows)
POSTGRES_HOST_PORT=5433

# Cổng nội bộ container PostgreSQL
POSTGRES_CONTAINER_PORT=5432

# URL kết nối từ Host Windows vào Docker DB
DATABASE_URL=postgresql://postgres:123@localhost:5433/personalized_learning_db

# URL kết nối nội bộ giữa các container trong Docker network (docker-compose)
DOCKER_DATABASE_URL=postgresql://postgres:123@postgres:5432/personalized_learning_db

# ------------------------------------------------------------------------------
# pgAdmin Configuration (Web UI Quản trị CSDL - Tùy chọn)
# ------------------------------------------------------------------------------
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@huit.edu.vn
PGADMIN_DEFAULT_PASSWORD=admin_secret_pass

# ------------------------------------------------------------------------------
# Machine Learning Service / Artifact Paths
# ------------------------------------------------------------------------------
MODEL_PATH=apps/backend/artifacts/model_hco_vnls_lightgbm_cutoff75.joblib
MODEL_ARTIFACTS_DIR=apps/backend/artifacts
RAW_DATA_PATH=data/raw/student_academic_records.csv

# ------------------------------------------------------------------------------
# Frontend Application
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
