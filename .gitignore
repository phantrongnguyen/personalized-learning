# Private/local datasets, including spreadsheets copied directly into data/.
# Keep documentation/placeholders; add narrowly scoped exceptions only for
# reviewed, anonymized public samples. Do not ignore all CSV/XLSX globally:
# experiment result tables and document assets may be intentional deliverables.
/data/*
!/data/.gitkeep
!/data/README.md
!/data/raw/
!/data/interim/
!/data/processed/

# Heavy Raw Data & Datasets (Only keep .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Database backups, local database files and container volumes.
# Do not ignore *.sql: schema, seed and migration SQL must stay versioned.
*.dump
*.backup
*.sql.gz
*.sql.bz2
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
/backups/
/database/backups/
/docker/volumes/
/docker/postgres/data/
/docker/pgadmin/data/

# Generated test output can contain account data, tokens, local paths or images.
# Keep test source and daily reports; publish sanitized evidence deliberately.
# Ignore rules do not remove files already tracked by Git.
!/reports/test-results/
/reports/test-results/*
!/reports/test-results/.gitkeep
!/reports/test-results/README.md

# Model Checkpoints & Large Artifacts
*.joblib
*.pkl
*.pickle
*.ckpt
# This reviewed artifact is a runtime dependency, not a disposable checkpoint.
!apps/backend/artifacts/model_hco_vnls_lightgbm_cutoff75.joblib
packages/ml/artifacts/models/*
!packages/ml/artifacts/models/.gitkeep
packages/ml/artifacts/scalers/*
!packages/ml/artifacts/scalers/.gitkeep
packages/ml/artifacts/encoders/*
!packages/ml/artifacts/encoders/.gitkeep
!docs/
docs/data/*.zip
*.zip
# Word Documents
reports/words/
