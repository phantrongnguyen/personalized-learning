# Environment Variables Template
PROJECT_NAME=kltn13-personalized-learning-recommendation
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=personalized_learning_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/personalized_learning_db

# Machine Learning Service / Artifact Paths
MODEL_ARTIFACTS_DIR=packages/ml/artifacts/models
RAW_DATA_PATH=data/raw/student_academic_records.csv

# Frontend Application
VITE_API_BASE_URL=http://localhost:8000/api/v1
